<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.geometry.Insets?>

<!-- Vue gestion des salles — CinéTrack -->
<!-- Contrôleur : controlleur.fx.SalleFxController -->
<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controlleur.fx.SalleFxController"
            stylesheets="@../css/style.css"
            style="-fx-background-color: #f8f9fa;">

    <!-- EN-TÊTE -->
    <top>
        <VBox style="-fx-background-color: white; -fx-border-color: #dee2e6; -fx-border-width: 0 0 1 0;">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>

                <Label text="  Gestion des Salles" styleClass="label-title"/>
                <Region HBox.hgrow="ALWAYS"/>

                <Button text="  Rafraîchir"
                        styleClass="btn-secondary"
                        onAction="#actionRafraichir"
                        style="-fx-padding: 7 14 7 14;"/>
            </HBox>
        </VBox>
    </top>

    <!-- TABLEAU DES SALLES -->
    <center>
        <VBox spacing="0" style="-fx-background-color: #f8f9fa;">
            <padding><Insets top="16" right="16" bottom="0" left="16"/></padding>

            <TableView fx:id="tableSalles"
                       styleClass="table-view"
                       VBox.vgrow="ALWAYS"
                       onMouseClicked="#actionSelectionSalle">
                <columns>
                    <TableColumn fx:id="colIdSalle"  text="ID"        prefWidth="70"/>
                    <TableColumn fx:id="colNomSalle" text="Nom de la salle" prefWidth="250"/>
                    <TableColumn fx:id="colCapacite" text="Capacité (places)" prefWidth="160"/>
                </columns>
                <placeholder>
                    <Label text="Aucune salle trouvée." styleClass="label-muted"/>
                </placeholder>
            </TableView>
        </VBox>
    </center>

    <!-- FORMULAIRE À DROITE -->
    <right>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                    style="-fx-background-color: white; -fx-border-color: #dee2e6; -fx-border-width: 0 0 0 1;">

            <VBox spacing="12" prefWidth="280"
                  style="-fx-background-color: white; -fx-padding: 20;">

                <Label fx:id="labelTitreFormulaire"
                       text="Ajouter une salle"
                       styleClass="label-subtitle"/>
                <Separator/>

                <Label text="Nom de la salle *" styleClass="label-champ"/>
                <TextField fx:id="champNom"
                           promptText="Ex: Salle 1 IMAX"
                           styleClass="text-field-modern"/>

                <Label text="Capacité en places *" styleClass="label-champ"/>
                <TextField fx:id="champCapacite"
                           promptText="Ex: 200"
                           styleClass="text-field-modern"/>

                <Label fx:id="labelMessage"
                       text=""
                       wrapText="true"
                       style="-fx-min-height: 20px;"/>

                <Button text="  Ajouter"
                        styleClass="btn-success"
                        onAction="#actionAjouter"
                        prefWidth="Infinity"
                        style="-fx-padding: 9 0 9 0;">
                    <VBox.margin><Insets top="6"/></VBox.margin>
                </Button>

                <Button text="  Modifier"
                        styleClass="btn-warning"
                        onAction="#actionModifier"
                        prefWidth="Infinity"
                        style="-fx-padding: 9 0 9 0;"/>

                <Button text="  Supprimer"
                        styleClass="btn-danger"
                        onAction="#actionSupprimer"
                        prefWidth="Infinity"
                        style="-fx-padding: 9 0 9 0;"/>

                <Button text="Vider"
                        styleClass="btn-secondary"
                        onAction="#actionVider"
                        prefWidth="Infinity"
                        style="-fx-padding: 7 0 7 0;">
                    <VBox.margin><Insets top="4"/></VBox.margin>
                </Button>

            </VBox>
        </ScrollPane>
    </right>

</BorderPane>
