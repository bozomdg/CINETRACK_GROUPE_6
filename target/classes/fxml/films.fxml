<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.geometry.Insets?>

<!-- Vue gestion des films — CinéTrack -->
<!-- Contrôleur : controlleur.fx.FilmFxController -->
<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controlleur.fx.FilmFxController"
            stylesheets="@../css/style.css"
            style="-fx-background-color: #f8f9fa;">

    <!-- ═══════════════════════════════════════════════
         EN-TÊTE DE LA VUE
         ═══════════════════════════════════════════════ -->
    <top>
        <VBox style="-fx-background-color: white; -fx-border-color: #dee2e6; -fx-border-width: 0 0 1 0;">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>

                <!-- Titre de la section -->
                <Label text="  Gestion des Films" styleClass="label-title"/>
                <Region HBox.hgrow="ALWAYS"/>

                <!-- Filtre par genre -->
                <Label text="Genre :" styleClass="label-muted"/>
                <ComboBox fx:id="comboFiltreGenre"
                          promptText="Tous les genres"
                          styleClass="combo-box"
                          prefWidth="160"
                          onAction="#actionFiltrer"/>

                <!-- Bouton Rafraîchir -->
                <Button text="  Rafraîchir"
                        styleClass="btn-secondary"
                        onAction="#actionRafraichir"
                        style="-fx-padding: 7 14 7 14;"/>
            </HBox>
        </VBox>
    </top>

    <!-- ═══════════════════════════════════════════════
         CENTRE : Tableau des films
         ═══════════════════════════════════════════════ -->
    <center>
        <VBox spacing="0" style="-fx-background-color: #f8f9fa;">
            <padding><Insets top="16" right="16" bottom="0" left="16"/></padding>

            <TableView fx:id="tableFilms"
                       styleClass="table-view"
                       VBox.vgrow="ALWAYS"
                       onMouseClicked="#actionSelectionFilm">

                <!-- Colonne ID -->
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50"/>

                    <!-- Colonne Titre -->
                    <TableColumn fx:id="colTitre" text="Titre" prefWidth="220"/>

                    <!-- Colonne Genre -->
                    <TableColumn fx:id="colGenre" text="Genre" prefWidth="130"/>

                    <!-- Colonne Durée -->
                    <TableColumn fx:id="colDuree" text="Durée" prefWidth="90"/>

                    <!-- Colonne Synopsis -->
                    <TableColumn fx:id="colSynopsis" text="Synopsis" prefWidth="320"/>
                </columns>

                <!-- Message si tableau vide -->
                <placeholder>
                    <Label text="Aucun film trouvé." styleClass="label-muted"/>
                </placeholder>
            </TableView>
        </VBox>
    </center>

    <!-- ═══════════════════════════════════════════════
         PANNEAU DROIT : Formulaire Ajout/Modification
         ═══════════════════════════════════════════════ -->
    <right>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                    style="-fx-background-color: white; -fx-border-color: #dee2e6; -fx-border-width: 0 0 0 1;">

            <VBox spacing="12" prefWidth="280"
                  style="-fx-background-color: white; -fx-padding: 20;">

                <!-- Titre formulaire -->
                <Label fx:id="labelTitreFormulaire"
                       text="Ajouter un film"
                       styleClass="label-subtitle"/>
                <Separator/>

                <!-- Champ Titre -->
                <Label text="Titre *" styleClass="label-champ"/>
                <TextField fx:id="champTitre"
                           promptText="Titre du film"
                           styleClass="text-field-modern"/>

                <!-- Champ Genre -->
                <Label text="Genre *" styleClass="label-champ"/>
                <ComboBox fx:id="comboGenre"
                          promptText="Choisir un genre"
                          styleClass="combo-box"
                          prefWidth="Infinity"/>

                <!-- Champ Durée -->
                <Label text="Durée  *" styleClass="label-champ"/>
                <TextField fx:id="champDuree"
                           promptText="Ex: 2h15 ou 135"
                           styleClass="text-field-modern"/>

                <!-- Champ Synopsis -->
                <Label text="Synopsis" styleClass="label-champ"/>
                <TextField fx:id="champSynopsis"
                           promptText="Résumé du film"
                           styleClass="text-field-modern"/>

                <!-- Message feedback (erreur ou succès) -->
                <Label fx:id="labelMessage"
                       text=""
                       wrapText="true"
                       style="-fx-min-height: 20px;"/>

                <!-- Bouton Ajouter -->
                <Button text="  Ajouter"
                        styleClass="btn-success"
                        onAction="#actionAjouter"
                        prefWidth="Infinity"
                        style="-fx-padding: 9 0 9 0;">
                    <VBox.margin><Insets top="6"/></VBox.margin>
                </Button>

                <!-- Bouton Modifier -->
                <Button text="  Modifier"
                        styleClass="btn-warning"
                        onAction="#actionModifier"
                        prefWidth="Infinity"
                        style="-fx-padding: 9 0 9 0;"/>

                <!-- Bouton Supprimer -->
                <Button text="  Supprimer"
                        styleClass="btn-danger"
                        onAction="#actionSupprimer"
                        prefWidth="Infinity"
                        style="-fx-padding: 9 0 9 0;"/>

                <!-- Bouton Vider le formulaire -->
                <Button text="Vider"
                        styleClass="btn-secondary"
                        onAction="#actionVider"
                        prefWidth="Infinity"
                        style="-fx-padding: 7 0 7 0;">
                    <VBox.margin><Insets top="4"/></VBox.margin>
                </Button>

            </VBox>
        </ScrollPane>
    </right>

</BorderPane>
